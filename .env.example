# ── IRIS backend ─────────────────────────────────────────────
# Dataset JSON (the notebooks' record shape: id/question/answer/image).
# For a quick start, point at the committed synthetic sample data:
IRIS_DATASET_JSON=iris-backend/sample_data/dataset.json

# Directory holding the chart images; served at /images/<basename>.
IRIS_IMAGE_DIR=iris-backend/sample_data/images

# Directory with stored run outputs for replay mode:
# decomp_alg2.json (preferred — carries the full RoSE paths) or
# decomp_alg2.csv, plus optionally decomp_alg1.*. Drop the Kaggle run
# outputs here for the real demo.
IRIS_RESULTS_DIR=iris-backend/sample_data/results

# Results JSON whose rows rebuild the 7B experience pool at startup
# (usually the same decomp_alg2.json). Unset = start with an empty pool.
#IRIS_POOL_PATH=chartqapro/results/decompose/decomp_alg2.json

# Let live runs keep growing the pool (default: read-only during demos).
IRIS_POOL_STREAM=false

# Force replay-only mode. Unset = auto: live when CUDA is available.
IRIS_DEMO_MODE=true

# Where uploaded PDFs and crops are stored (default: a temp dir).
#IRIS_UPLOAD_DIR=/tmp/iris-uploads

# Origins allowed by CORS (the frontend's origin).
IRIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── IRIS frontend ────────────────────────────────────────────
# The ONLY host the frontend ever calls (zero-cost constraint).
IRIS_API_URL=http://localhost:8000
