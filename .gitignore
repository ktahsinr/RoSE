# Dependencies
node_modules/

# Python virtual environment
.venv/
__pycache__/
*.py[cod]

# Build output
dist/
build/

# ChartQAPro run outputs — a real run logs every generation and is far too
# large for git. Keep the folder (and the checked-in .gitkeep) so the pipeline
# and the web API always have somewhere to look.
chartqapro/results/*
!chartqapro/results/.gitkeep

# …except the routing pilot: the 150-question sample, the per-model pilot
# results, the routing pool and the pilot report are small and every Stage 2
# number depends on them, so they ARE versioned.
!chartqapro/results/pilot/
!chartqapro/results/pilot/*

# Environment / secrets
.env
.env.*
*.pem
*.key

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
